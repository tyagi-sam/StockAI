# ============================================================================
# Stock AI — environment template
# Copy to .env and fill in real values:   cp env.example .env
# On the new server, paste the secret values from your old EC2 .env.
# ============================================================================

# ---- Domain / URLs --------------------------------------------------------
# The single source of truth for your public hostname. Change this one value
# to move the whole app to a new domain (nginx + frontend pick it up).
# For the Oracle + DuckDNS setup this is e.g. stock-ai-demo.duckdns.org
DOMAIN=your-subdomain.duckdns.org

# Built into the frontend at build time. Leave commented to auto-derive from
# DOMAIN (https://$DOMAIN/api/v1). Only set it if you need a different API host.
# VITE_API_URL=https://your-subdomain.duckdns.org/api/v1

FRONTEND_URL=https://your-subdomain.duckdns.org
BACKEND_CORS_ORIGINS=https://your-subdomain.duckdns.org
ENVIRONMENT=production

# ---- Database / cache (compose defaults shown; change for prod) -----------
POSTGRES_USER=stock_ai_user
POSTGRES_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_strong_password

# ---- Auth / crypto --------------------------------------------------------
JWT_SECRET=change_me_at_least_32_characters_long_secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- Google OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Zerodha (Kite Connect) ----------------------------------------------
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ---- Market data ----------------------------------------------------------
# Twelve Data serves datacenter IPs (Yahoo/yfinance gets rate-limited on cloud
# hosts like Render). Free key: https://twelvedata.com/pricing  (~800 req/day).
# Leave blank for local dev and the app falls back to yfinance.
TWELVE_DATA_API_KEY=

# ---- OpenAI (optional) ----------------------------------------------------
OPENAI_API_KEY=

# ---- Email / SMTP ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
FROM_EMAIL=
FROM_NAME=Stock AI

# ---- OTP ------------------------------------------------------------------
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
